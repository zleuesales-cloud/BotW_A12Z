<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TotkXlateAssembly Condition="'$(TotkXlateAssembly)' == ''">../bin/Release/net10.0/osx-arm64/totk_xlate.dll</TotkXlateAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="totk_xlate">
      <HintPath>$(TotkXlateAssembly)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
